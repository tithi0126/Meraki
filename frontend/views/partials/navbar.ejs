<!-- Modern Glassmorphic Navbar -->
<nav class="navbar navbar-expand-lg sticky-top" role="navigation" aria-label="Main navigation">
  <div class="container">
    <!-- Brand -->
    <a class="navbar-brand d-flex align-items-center" href="/" aria-label="Meraki Coffee House - Home">
      <img src="/images/merakiLogo.png" alt="Meraki Coffee House Logo" class="navbar-logo" loading="eager">
      <div class="brand-text ms-2">
        <span class="brand-main">Meraki</span>
        <span class="brand-subtitle">Coffee House</span>
      </div>
    </a>

    <!-- Toggler with custom animated icon -->
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navigation Menu -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link <%= typeof path !== 'undefined' && path === '/' ? 'active' : '' %>" href="/" <%=typeof path
            !=='undefined' && path==='/' ? 'aria-current="page"' : '' %>>Home</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= typeof path !== 'undefined' && path.startsWith('/menu') ? 'active' : '' %>" 
             href="/menu" id="menuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
             Menu
          </a>
          <ul class="dropdown-menu border-0 shadow-sm rounded-3 mt-2" aria-labelledby="menuDropdown">
            <li><a class="dropdown-item py-2" href="/menu">All Items</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item py-2" href="/menu?category=HOT%20COFFEE">Hot Coffee</a></li>
            <li><a class="dropdown-item py-2" href="/menu?category=ICED%20COFFEE">Iced Coffee</a></li>
            <li><a class="dropdown-item py-2" href="/menu?category=HOUSE%20SPECIALS">House Specials</a></li>
            <li><a class="dropdown-item py-2" href="/menu?category=MANUAL%20BREW">Manual Brew</a></li>
            <li><a class="dropdown-item py-2" href="/menu?category=SHAKES">Shakes</a></li>
            <li><a class="dropdown-item py-2" href="/menu?category=HOT%20CHOCOLATE">Hot Chocolate</a></li>
            <li><a class="dropdown-item py-2" href="/menu?category=TEA">Tea</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof path !== 'undefined' && path === '/about' ? 'active' : '' %>" href="/about"
            <%=typeof path !=='undefined' && path==='/about' ? 'aria-current="page"' : '' %>>Story</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof path !== 'undefined' && path === '/review' ? 'active' : '' %>" href="/review"
            <%=typeof path !=='undefined' && path==='/review' ? 'aria-current="page"' : '' %>>Reviews</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof path !== 'undefined' && path === '/contact' ? 'active' : '' %>" href="/contact"
            <%=typeof path !=='undefined' && path==='/contact' ? 'aria-current="page"' : '' %>>Contact</a>
        </li>
      </ul>

      <!-- Action Items (Cart & User) -->
      <ul class="navbar-nav align-items-center gap-3">
        <!-- Cart -->
        <li class="nav-item">
          <a class="nav-link cart-link position-relative p-2" href="/cart" aria-label="Shopping cart">
            <i class="fas fa-shopping-bag fa-lg"></i>
            <span class="cart-badge badge rounded-pill d-none" id="cart-count">
              0
              <span class="visually-hidden">items in cart</span>
            </span>
          </a>
        </li>

        <!-- User Links - Populated by JavaScript -->
        <div id="user-links" class="d-flex align-items-center gap-2">
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/login">Login</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-nav-register text-white px-4 rounded-pill" href="/register">Sign Up</a>
          </li>
        </div>
      </ul>
    </div>
  </div>
</nav>

<script>
  // Navbar scroll effect
  window.addEventListener('scroll', function () {
    const navbar = document.querySelector('.navbar');
    if (window.scrollY > 20) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  });
</script>