<%- include('partials/header') %>
    <%- include('partials/navbar') %>

        <!-- Login success message -->
        <div id="login-message" class="container mt-3" style="display: none;">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> <span id="login-message-text"></span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>

        <!-- 1. Full-Screen Hero -->
        <section class="hero text-white text-center d-flex align-items-center justify-content-center"
            style="min-height: 100vh;">
            <div class="container" data-reveal>
                <h1 class="display-1 fw-bold mb-4">Crafting Memories,<br>One Cup at a Time</h1>
                <p class="lead mb-5" style="font-weight: 300; letter-spacing: 1px;">Experience the art of roasting and
                    brewing at Meraki.</p>
                <div class="hero-buttons d-flex justify-content-center gap-3">
                    <a href="/menu" class="btn btn-light btn-lg px-5 py-3 rounded-pill">Explore Menu</a>
                    <a href="/about" class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill">Our Story</a>
                </div>
            </div>
            <a href="#features" class="scroll-indicator text-white text-decoration-none">
                <span class="d-block mb-2 text-uppercase" style="font-size: 0.8rem; letter-spacing: 2px;">Scroll</span>
                <i class="fas fa-chevron-down"></i>
            </a>
        </section>

        <!-- Infinite Marquee -->
        <div class="marquee-section">
            <div class="marquee-content">
                <span class="marquee-item">Freshly Roasted</span>
                <span class="marquee-item"><i class="fas fa-certificate"></i></span>
                <span class="marquee-item">Ethically Sourced</span>
                <span class="marquee-item"><i class="fas fa-certificate"></i></span>
                <span class="marquee-item">Expertly Brewed</span>
                <span class="marquee-item"><i class="fas fa-certificate"></i></span>
                <span class="marquee-item">Community Focused</span>
                <span class="marquee-item"><i class="fas fa-certificate"></i></span>
                <span class="marquee-item">Freshly Roasted</span> <!-- Duplicate for loop -->
                <span class="marquee-item"><i class="fas fa-certificate"></i></span>
                <span class="marquee-item">Ethically Sourced</span>
            </div>
        </div>

        <!-- 2. "Why Choose Us" Features (Overlaps Hero) -->
        <section class="features-section pb-5" id="features">
            <div class="container">
                <div class="row g-4 justify-content-center">
                    <!-- Feature 1 -->
                    <div class="col-md-4" data-reveal>
                        <div class="feature-card h-100">
                            <div class="feature-icon">
                                <i class="fas fa-leaf"></i>
                            </div>
                            <h4 class="mb-3">Sustainably Sourced</h4>
                            <p class="text-muted">We partner directly with farmers to bring you the finest, ethically
                                harvested beans from around the world.</p>
                        </div>
                    </div>
                    <!-- Feature 2 -->
                    <div class="col-md-4" data-reveal>
                        <div class="feature-card h-100">
                            <div class="feature-icon">
                                <i class="fas fa-fire"></i>
                            </div>
                            <h4 class="mb-3">Master Roasting</h4>
                            <p class="text-muted">Our small-batch roasting process ensures every bean reaches its peak
                                flavor and aroma potential.</p>
                        </div>
                    </div>
                    <!-- Feature 3 -->
                    <div class="col-md-4" data-reveal>
                        <div class="feature-card h-100">
                            <div class="feature-icon">
                                <i class="fas fa-mug-hot"></i>
                            </div>
                            <h4 class="mb-3">Expert Baristas</h4>
                            <p class="text-muted">Passion and precision go into every pour, guaranteeing a perfect cup
                                that warms your soul.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. Featured Collection (Enhanced) -->
        <section class="section-fade-in py-5">
            <div class="container">
                <div class="featured-header text-center">
                    <% if (typeof isMenuComingSoon !== 'undefined' && isMenuComingSoon) { %>
                        <h2 class="section-title text-warning">Menu Coming Soon</h2>
                        <p class="text-muted lead">We are currently curating our selection. Please check back later.</p>
                    <% } else { %>
                        <h2 class="section-title">Curated Selection</h2>
                        <p class="text-muted">Discover our seasonal favorites</p>
                    <% } %>
                </div>

                <div class="row g-4">
                    <% if (featuredItems && featuredItems.length> 0) { %>
                        <% featuredItems.forEach((item, index)=> { %>
                            <div class="col-md-4">
                                <div class="card card-hover h-100 border-0 shadow-sm">
                                    <span class="product-price-badge">₹<%= item.price %></span>
                                    <% if (item.image_url) { %>
                                        <img src="<%= item.image_url %>" class="card-img-top" alt="<%= item.name %>"
                                            style="height: 350px;">
                                        <% } else { %>
                                            <div class="card-img-top fallback-image" style="height: 350px;">
                                                <i class="fas fa-coffee"></i>
                                            </div>
                                            <% } %>
                                                <div class="card-body text-center p-4">
                                                    <h5 class="card-title mb-1">
                                                        <%= item.name %>
                                                    </h5>
                                                    <small class="text-uppercase text-primary fw-bold mb-3 d-block"
                                                        style="font-size: 0.75rem; letter-spacing: 1px;">
                                                        <%= item.category %>
                                                    </small>
                                                    <p class="card-text text-muted mb-4">
                                                        <%= item.description
                                                            || 'A delicious choice for your daily brew.' %>
                                                    </p>
                                                    <button
                                                        class="btn btn-outline-primary rounded-pill px-4 add-to-cart w-100"
                                                        data-id="<%= item.id %>" data-name="<%= item.name %>"
                                                        data-price="<%= item.price %>">
                                                        Add to Cart
                                                    </button>
                                                </div>
                                </div>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div class="col-12 text-center py-5">
                                        <p class="text-muted">No featured items available at the moment.</p>
                                    </div>
                                    <% } %>
                </div>
                <div class="text-center mt-5">
                    <a href="/menu" class="btn btn-primary btn-lg rounded-pill px-5">View Full Menu <i
                            class="fas fa-arrow-right ms-2"></i></a>
                </div>
            </div>
        </section>

        <!-- 4. Parallax "Mood" Banner -->
        <section class="parallax-banner"
            style="background-image: url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80');">
            <div class="parallax-overlay"></div>
            <div class="parallax-content" data-reveal>
                <h2 class="display-4 fw-bold mb-3 text-white">"Coffee is a language in itself."</h2>
                <p class="lead mb-4 text-white">- Jackie Chan</p>
                <a href="/about" class="btn btn-outline-light rounded-pill px-5">Discover Our Vibe</a>
            </div>
        </section>

        <!-- 5. "Our Story" Magazine Layout -->
        <section class="story-section py-5 my-5">
            <div class="container">
                <div class="row align-items-center g-5">
                    <!-- Story content can be added here -->
                </div>
            </div>
        </section>

        <%- include('partials/footer') %>