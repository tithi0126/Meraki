<%- include('partials/header') %>
    <%- include('partials/navbar') %>

        <!-- 1. Menu Hero -->
        <section class="hero-small d-flex align-items-center justify-content-center text-center text-white"
            style="min-height: 50vh; background: linear-gradient(rgba(44, 24, 16, 0.8), rgba(44, 24, 16, 0.8)), url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80') center/cover no-repeat;">
            <div class="container" data-reveal>
                <span class="d-block text-uppercase mb-3 text-warning"
                    style="letter-spacing: 3px; font-weight: 600;">Explore</span>
                <h1 class="display-2 fw-bold mb-4 font-display text-white">Our Curated Menu</h1>
                <p class="lead" style="max-width: 600px; margin: 0 auto; opacity: 0.9;">Hand-crafted beverages and
                    delightful treats, prepared with precision and passion.</p>
            </div>
        </section>

        <!-- 2. Menu Content -->
        <section class="py-5 bg-light">
            <div class="container py-4">

                <% if (typeof isMenuComingSoon !== 'undefined' && isMenuComingSoon) { %>
                    <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 mb-5 text-center" data-reveal>
                        <h2 class="font-display fw-bold text-primary mb-2">Menu Coming Soon</h2>
                        <p class="text-muted mb-0">We are currently curating our selection. Please check back later. In the meantime, enjoy our standard favorites below!</p>
                    </div>
                <% } %>

                <% if (Object.keys(menuByCategory).length> 0) { %>
                    <% Object.keys(menuByCategory).forEach((category, index)=> { %>
                        <!-- Category Section -->
                        <div class="mb-5 pb-3" data-reveal>
                            <div class="text-center mb-5 position-relative">
                                <h2 class="display-5 font-display text-primary d-inline-block px-4 bg-light position-relative"
                                    style="z-index: 2;">
                                    <%= category %>
                                </h2>
                                <div class="position-absolute top-50 start-0 w-100 border-top border-warning"
                                    style="opacity: 0.3; transform: translateY(-50%); z-index: 1;"></div>
                            </div>

                            <div class="row g-4">
                                <% menuByCategory[category].forEach(item=> { %>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card h-100 border-0 shadow-sm card-hover overflow-hidden rounded-4">
                                            <!-- Image Wrapper -->
                                            <div class="position-relative overflow-hidden" style="padding-top: 75%;">
                                                <% if (item.image_url) { %>
                                                    <img src="<%= item.image_url %>"
                                                        class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover transition-transform"
                                                        alt="<%= item.name %>" style="transition: transform 0.5s ease;">
                                                    <% } else { %>
                                                        <div
                                                            class="position-absolute top-0 start-0 w-100 h-100 bg-light d-flex align-items-center justify-content-center text-muted">
                                                            <i class="fas fa-coffee fa-3x opacity-50"></i>
                                                        </div>
                                                        <% } %>
                                                            <div class="position-absolute top-0 end-0 m-3">
                                                                <span
                                                                    class="badge bg-white text-primary shadow-sm rounded-pill px-3 py-2 fw-bold">
                                                                    ₹<%= item.price %>
                                                                </span>
                                                            </div>
                                            </div>

                                            <!-- Body -->
                                            <div class="card-body p-4 d-flex flex-column">
                                                <div class="mb-2">
                                                    <span class="text-uppercase text-warning fw-bold"
                                                        style="font-size: 0.7rem; letter-spacing: 1px;">
                                                        <%= item.category %>
                                                    </span>
                                                </div>
                                                <h4 class="card-title font-display fw-bold mb-2">
                                                    <%= item.name %>
                                                </h4>
                                                <p class="card-text text-muted small mb-4 flex-grow-1">
                                                    <%= item.description
                                                        || 'A delicious choice from our exclusive collection.' %>
                                                </p>

                                                <!-- Action -->
                                                <button
                                                    class="btn btn-outline-primary w-100 rounded-pill py-2 add-to-cart position-relative overflow-hidden group-hover-btn"
                                                    data-id="<%= item.id %>" data-name="<%= item.name %>"
                                                    data-price="<%= item.price %>">
                                                    <span
                                                        class="position-relative z-1 d-flex align-items-center justify-content-center gap-2">
                                                        <i class="fas fa-plus"></i> Add to Cart
                                                    </span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                            </div>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="text-center py-5" data-reveal>
                                    <div class="mb-4">
                                        <i class="fas fa-clock fa-4x text-warning opacity-50"></i>
                                    </div>
                                    <h2 class="font-display fw-bold text-primary mb-3">Menu Coming Soon</h2>
                                    <p class="text-muted lead mx-auto" style="max-width: 500px;">We are currently curating our selection. Please check back later.</p>
                                    <div class="mt-5">
                                        <a href="/" class="btn btn-outline-primary rounded-pill px-5">Back to Home</a>
                                    </div>
                                </div>
                                <% } %>
            </div>
        </section>

        <style>
            /* Local overrides for menu specific interactions */
            .card-hover:hover img {
                transform: scale(1.1);
            }

            .card-hover:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow-xl) !important;
            }
        </style>

        <%- include('partials/footer') %>